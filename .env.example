DATABASE_URL=postgresql://denser:denser@localhost:5434/denser
BETTER_AUTH_SECRET=dev-auth-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3457
APP_ORIGIN=http://localhost:5173
API_PORT=3457
SEED_PASSWORD=password
SEED_MODE=minimal

# BlobStore adapter selection (ticket 16). Omit to keep the NotImplemented stub.
BLOB_STORE_ADAPTER=s3            # s3 | r2

# AWS S3 (when BLOB_STORE_ADAPTER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=denser-attachments
# S3_FOLDER=uploads                 # optional; defaults to uploads
# S3_ENDPOINT=                      # optional; omit for standard AWS S3
# S3_PUBLIC_BASE_URL=               # optional; inferred as https://{bucket}.s3.{region}.amazonaws.com

# Cloudflare R2 (when BLOB_STORE_ADAPTER=r2)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_FOLDER=uploads
# R2_ENDPOINT=                      # optional; inferred from R2_ACCOUNT_ID
# R2_PUBLIC_BASE_URL=               # optional; e.g. https://pub-xxxx.r2.dev
