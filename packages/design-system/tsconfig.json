{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"],
    "declaration": false,
    "declarationMap": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", ".storybook", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e"],
  "exclude": ["src/**/*.stories.ts"]
}
