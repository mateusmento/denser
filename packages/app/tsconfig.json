{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/utils": ["../design-system/src/lib/utils.ts"],
      "@/components/*": ["../design-system/src/components/*"],
      "@/composables/*": ["../design-system/src/composables/*"]
    },
    "types": ["vite/client"],
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", ".storybook", "e2e", "playwright.config.ts", "vite.config.ts", "env.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
